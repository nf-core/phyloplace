/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/phyloplace -profile test_phylosearch_catalogue,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Several sample sheets test profile'
    config_profile_description = 'Search and place with the sample sheet split in a shared collection of reference phylogenies and a sheet of own profiles'

    // The two sheets together hold the rows of test_phylosearch_input's single sheet
    phylosearch_input   = params.pipelines_testdata_base_path + 'phyloplace/testdata/phylosearch_catalogue.csv,' +
                          params.pipelines_testdata_base_path + 'phyloplace/testdata/phylosearch_own.csv'
    search_fasta        = params.pipelines_testdata_base_path + 'phyloplace/testdata/domain_16s.fna'
}
