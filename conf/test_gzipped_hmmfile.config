/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/phyloplace -profile test_gzipped_hmmfile,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile for gzipped input with a pre-built HMM profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    // The hmmer branch with a gzipped hmmfile, which test_gzipped's mafft branch never
    // reaches. alignmethod is left unset for the same reason as in test_hmmfile.
    queryseqfile = params.pipelines_testdata_base_path + "phyloplace/testdata/gzipped/PF14720_3_sequences.faa.gz"
    refseqfile   = params.pipelines_testdata_base_path + "phyloplace/testdata/gzipped/PF14720_seed.faa.gz"
    hmmfile      = params.pipelines_testdata_base_path + "phyloplace/testdata/gzipped/PF14720.hmm.gz"
    refphylogeny = params.pipelines_testdata_base_path + "phyloplace/testdata/gzipped/PF14720_seed.ft.LGCAT.newick.gz"
    taxonomy     = params.pipelines_testdata_base_path + "phyloplace/testdata/gzipped/PF14720_seed.taxonomy.tsv.gz"
    model        = "LG"
}
