nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    profile "test_mafft"

    test("-profile test_mafft") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_phyloplace_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content,
                    path("${params.outdir}/gappa/placement.taxonomy.per_query.tsv").csv(sep: '\t', header: true).rowCount,
                    path("${params.outdir}/gappa/placement.taxonomy.profile.tsv").csv(sep: '\t', header: true).rowCount,
                    path("${params.outdir}/gappa/placement.taxonomy.sativa.tsv").csv(sep: '\t', header: true).rowCount,
                ).match() }
            )
        }
    }

    test("-profile test_mafft, query with an insertion") {

        when {
            params {
                outdir = "$outputDir"
                // E1QGS5_DESB2 from the reference alignment, ungapped, with 20 W inserted: MAFFT adds
                // columns for the insertion unless run with --keeplength
                def query = new File("$outputDir/insertion.faa")
                query.parentFile.mkdirs()
                query.text = ">insertion\nYGATIHDKCPRRAHFEEAEFVKRFGDEGAINGWCLFEMGC${'W' * 20}KGPDTHNNCSLVKFNDGTNWPVGAGHPCLGCSEPQFWDNMAPFY\n"
                queryseqfile = query.toString()
            }
        }

        then {
            def widths = { fasta -> fasta.values()*.length().unique() }
            assertAll(
                { assert workflow.success },
                { assert widths(path("${params.outdir}/mafft/placement.fas.gz").fasta) == widths(path("${params.outdir}/resolvetaxonomy/placement.resolved.alnfaa").fasta) }
            )
        }
    }
}
